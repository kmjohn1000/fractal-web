#!/bin/sh
# Runs before a push. Cheap by default: lint, a few seconds. A release tag
# (v*, which /release pushes) runs the two iPhone visual setups (npm run
# test:release: webkit-iphone15 and chromium-iphone15; the App Store build is
# iPhone and iPad only). Run the full four-setup suite by hand with
# `npm run test:visual` (or one spec: `npx playwright test
# tests/visual/<file>.spec.mjs`), or force it on a branch push with
# RUN_VISUAL=1 git push (full suite). SKIP_VISUAL=1 skips it even for a tag.
# Enabled by `npm install` (package.json's prepare script sets
# core.hooksPath to .githooks).

# git passes "<local ref> <local sha> <remote ref> <remote sha>" lines on
# stdin; keep them, they are read twice below.
refs=$(cat)

# A machine-local guard, if this clone has one (it lives in .git/, not in the
# repo): it gets git's arguments and the same ref lines, and can refuse the push.
local_guard="$(git rev-parse --git-common-dir)/local-hooks/pre-push"
if [ -x "$local_guard" ]; then
  printf '%s\n' "$refs" | "$local_guard" "$@" || {
    echo "pre-push: the local guard refused this push. Push aborted."
    exit 1
  }
fi

npm run lint </dev/null || {
  echo "pre-push: lint failed. Push aborted."
  exit 1
}

[ -n "$SKIP_VISUAL" ] && { echo "pre-push: SKIP_VISUAL set, not running the visual suite"; exit 0; }

release=""
while read -r _ _ remote_ref _; do
  case "$remote_ref" in refs/tags/v*) release=1 ;; esac
done <<EOF
$refs
EOF

if [ -n "$release" ] || [ -n "$RUN_VISUAL" ]; then
  npm run test:release </dev/null || {
    echo "pre-push: release visual suite (iPhone setups) failed; see test-results/report/index.html. Push aborted."
    exit 1
  }
else
  echo "pre-push: lint passed; the visual suite runs on a release tag (or RUN_VISUAL=1)"
fi
