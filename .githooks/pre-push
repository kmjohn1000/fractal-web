#!/bin/sh
# Runs the visual regression suite (npm run test:visual) before a push.
# Enabled by `npm install` (package.json's prepare script sets
# core.hooksPath to .githooks). Pushes whose new commits only touch docs
# (*.md) skip it; SKIP_VISUAL=1 git push skips it once.

[ -n "$SKIP_VISUAL" ] && { echo "pre-push: SKIP_VISUAL set, not running the visual suite"; exit 0; }

zero=0000000000000000000000000000000000000000
changed=""
# git passes "<local ref> <local sha> <remote ref> <remote sha>" lines.
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue  # deleting a remote branch
  if [ "$remote_sha" = "$zero" ]; then
    files=$(git diff-tree --no-commit-id --name-only -r "$local_sha")
  else
    files=$(git diff --name-only "$remote_sha" "$local_sha")
  fi
  changed="$changed
$files"
done

if [ -n "$(printf '%s\n' "$changed" | grep -v -e '^$' -e '\.md$')" ]; then
  npm run test:visual </dev/null || {
    echo "pre-push: visual suite failed; see test-results/report/index.html. Push aborted."
    exit 1
  }
else
  echo "pre-push: docs-only push, skipping the visual suite"
fi
