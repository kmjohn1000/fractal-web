#!/bin/sh
# Runs before a push. Cheap by default: lint, a few seconds. The visual
# regression suite (npm run test:visual, 8-10 minutes) runs only when the push
# carries a release tag (v*), which is what /release pushes. Run it by hand any
# time with `npm run test:visual` (or one spec: `npx playwright test
# tests/visual/<file>.spec.mjs`), or force it on a branch push with
# RUN_VISUAL=1 git push. SKIP_VISUAL=1 skips it even for a tag.
# Enabled by `npm install` (package.json's prepare script sets
# core.hooksPath to .githooks).

npm run lint </dev/null || {
  echo "pre-push: lint failed. Push aborted."
  exit 1
}

[ -n "$SKIP_VISUAL" ] && { echo "pre-push: SKIP_VISUAL set, not running the visual suite"; exit 0; }

# git passes "<local ref> <local sha> <remote ref> <remote sha>" lines.
release=""
while read -r _ _ remote_ref _; do
  case "$remote_ref" in refs/tags/v*) release=1 ;; esac
done

if [ -n "$release" ] || [ -n "$RUN_VISUAL" ]; then
  npm run test:visual </dev/null || {
    echo "pre-push: visual suite failed; see test-results/report/index.html. Push aborted."
    exit 1
  }
else
  echo "pre-push: lint passed; the visual suite runs on a release tag (or RUN_VISUAL=1)"
fi
