# Fractal Atlas: lanes that send things to App Store Connect.
#
# Building, archiving and exporting the IPA is done by /release
# (scripts/release-ios.mjs). These lanes only upload. Run them yourself:
# both ask for confirmation first (and fail instead of uploading when there
# is no terminal), and neither submits the version for review.
#
# One-time setup:
#   1. App Store Connect > Users and Access > Integrations > Keys: create an
#      API key with the App Manager role and download the .p8 once.
#   2. Keep the .p8 outside this repo (e.g. ~/.appstoreconnect/AuthKey_XXXX.p8).
#   3. In a Terminal window, only when releasing, export ASC_KEY_ID (the ID in
#      the AuthKey_<ID>.p8 filename), ASC_ISSUER_ID (Team Keys page) and
#      ASC_KEY_PATH. Keep them out of your shell profile and fastlane/.env so
#      Claude Code's shell doesn't inherit them.
#
#   fastlane check
#       Read-only: proves the API key works and compares the latest build
#       number on App Store Connect with the next one (git commit count).
#
#   fastlane upload [ipa:path/to/App.ipa]
#       Uploads the newest store-assets/*/ipa/*.ipa (or the one given).
#
#   fastlane listing version:<v> [screenshots:true]
#       Pushes the listing text for every language to the editable version
#       (the version must already exist in App Store Connect). With
#       screenshots:true it also replaces the screenshots of every locale with
#       the staged set, after a second confirmation. Neither input is made by
#       hand: /release step 8 writes fastlane/metadata/ from listing-<v>.md
#       (node scripts/listing-to-fastlane.mjs) and fastlane/screenshots/ from
#       the listing/<version>/app/ folders (node scripts/stage-screenshots.mjs).

opt_out_usage
default_platform(:ios)

REPO_ROOT = File.expand_path("..", __dir__)

def asc_key
  missing = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].select { |k| ENV[k].to_s.empty? }
  UI.user_error!("Set #{missing.join(', ')} (see the top of fastlane/Fastfile)") unless missing.empty?
  key_path = File.expand_path(ENV["ASC_KEY_PATH"])
  UI.user_error!("No API key file at #{key_path}") unless File.exist?(key_path)
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: key_path,
    in_house: false
  )
end

platform :ios do
  desc "Read-only: check the API key and compare build numbers with App Store Connect"
  lane :check do
    latest = latest_testflight_build_number(api_key: asc_key, initial_build_number: 0)
    # /release stamps the build number as the git commit count (npm run ios:sync).
    local = sh("git rev-list --count HEAD", log: false).strip.to_i
    UI.success("API key works.")
    UI.message("Latest build on App Store Connect: #{latest}")
    UI.message("Next build from this checkout (commit count): #{local}")
    if local > latest.to_i
      UI.success("Next build number is higher, so an upload will be accepted.")
    else
      UI.important("Next build number is NOT higher than the latest upload; Apple will reject it.")
    end
  end

  desc "Upload an exported IPA to App Store Connect (no review submission)"
  lane :upload do |options|
    ipa = if options[:ipa]
            File.expand_path(options[:ipa], REPO_ROOT)
          else
            Dir[File.join(REPO_ROOT, "store-assets", "*", "ipa", "*.ipa")].max_by { |f| File.mtime(f) }
          end
    UI.user_error!("No IPA found. Run /release first or pass ipa:<path>") unless ipa && File.exist?(ipa)
    UI.important("IPA: #{ipa} (#{(File.size(ipa) / 1_000_000.0).round(1)} MB)")
    UI.user_error!("Cancelled") unless UI.confirm("Upload this build to App Store Connect?")
    upload_to_testflight(
      api_key: asc_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Push listing text (and, with screenshots:true, the screenshot set) to the editable App Store version"
  lane :listing do |options|
    unless Dir["metadata/*/name.txt"].any?
      UI.user_error!("No metadata. /release step 8 writes it, or run: node scripts/listing-to-fastlane.mjs listing/<v>/listing-<v>.md")
    end
    # Screenshots (screenshots:true): deliver reads fastlane/screenshots/<locale>/*.png
    # and tells the device slot from each image's pixel size. That folder is
    # staged by `node scripts/stage-screenshots.mjs` (/release step 8 runs it).
    # The set replaces what is on the version for these locales: overwrite_screenshots
    # deletes each locale's existing screenshots first, so it asks before sending.
    with_shots = options[:screenshots].to_s == "true"
    if with_shots
      staged = Dir["screenshots/*/*.png"]
      locales = staged.map { |f| File.basename(File.dirname(f)) }.uniq
      if staged.empty?
        UI.user_error!("No staged screenshots. Run: node scripts/stage-screenshots.mjs")
      end
      UI.important("#{staged.size} screenshots staged for #{locales.size} locales (#{locales.sort.join(', ')}).")
      UI.important("This DELETES the existing screenshots of those locales on the editable version, then uploads these.")
      UI.user_error!("Cancelled") unless UI.confirm("Replace the screenshots on version #{options[:version]}?")
    end
    # metadata_path and screenshots_path are left unset on purpose: deliver then
    # uses fastlane/metadata and fastlane/screenshots. Passing a relative path
    # resolves it against the repo root, which created an empty metadata/ there.
    upload_to_app_store(
      api_key: asc_key,
      app_version: options[:version],
      skip_binary_upload: true,
      skip_screenshots: !with_shots,
      overwrite_screenshots: with_shots,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false
    )
  end
end
